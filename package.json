{
  "name": "pip-browser",
  "version": "0.1.7",
  "private": true,
  "description": "Mini navigateur flottant pour Windows",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "test:smoke": "electron test/smoke.cjs",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer.js && node --check src/player-mode.js && node --check src/surface-preload.js",
    "pack": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "fr.pipbrowser.desktop",
    "productName": "PiP Browser",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": "portable"
    },
    "directories": {
      "output": "release"
    }
  }
}
